        "types": [
          "LLM_MEMORY_VALIDATION"
        ]
      },
      "provider": "openrouter",
      "model": "mistralai/mistral-small-2603",
      "temperature": 0
    },
    {
      "selector": {
        "types": [
          "LLM_SEARCH_VALIDATION"
        ]
      },
      "provider": "openrouter",
      "model": "google/gemini-3.8-flash",
      "temperature": 0
    },
    {
      "selector": {
        "types": [
          "RAG_EVIDENCE_VALIDATION"
        ]
      },
      "provider": "openrouter",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0
    }
  ]
}
